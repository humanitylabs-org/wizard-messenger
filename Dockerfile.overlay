# Python/static-only packaging over the exact live binary carrier. No owner data.
# Carrier: the live 12.12 image; its /app md5-matches revision 288927b. Everything the Python/static tree
# changed since is copied over it with readable modes (12.10 shipped 0600 and crash-looped). Trusted-owner
# unlock and push need extra OS packages (full Dockerfile) and stay off on installs built from this overlay.
FROM wizard-messenger:0.2.0-unified.12.12
ARG REVISION
LABEL org.opencontainers.image.revision=$REVISION \
      org.opencontainers.image.version="0.2.0-unified.15.8" \
      org.opencontainers.image.source="https://github.com/humanitylabs-org/wizard-messenger"
COPY --chmod=0644 engine.py server.py web.py trusted_owner.py unified.py unified_setup.py telegram_application.py history_cursor.py permissions.py agent_keys.py agent_tools.py wizard_agents.py drafts.py remote_authority.py owner_unix.py API-contract.json /app/
COPY --chmod=0644 connector_setup.py connectors.py connector_inbox.py connector_sender.py browser_signin.py /app/
COPY --chmod=0644 readiness/search.py readiness/__init__.py /app/readiness/
COPY --chmod=0644 push_notifications/__init__.py push_notifications/runtime.py push_notifications/security.py push_notifications/service-worker.js push_notifications/requirements.txt /app/push_notifications/
COPY --chmod=0644 plumbing/connectors-provenance.json plumbing/connectors-view-integration.patch plumbing/connectors-web-integration.patch plumbing/dots-template.json plumbing/dots-upstream-LICENSE plumbing/facebook-template.json plumbing/gmessages-template.json plumbing/instagram-template.json plumbing/line-template.json plumbing/line-upstream-LICENSE plumbing/line.Dockerfile plumbing/linkedin-template.json plumbing/permission-runtime-integration.patch plumbing/slack-template.json plumbing/twitter-template.json /app/plumbing/
COPY --chmod=0644 static/index.html static/app.js static/app.css static/connectors.js static/unified.js static/unified.css /app/static/
