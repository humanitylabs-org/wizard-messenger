# Python/static-only packaging over the exact live binary carrier. No owner data.
FROM wizard-messenger:0.2.0-unified.11.14
ARG REVISION
LABEL org.opencontainers.image.revision=$REVISION \
      org.opencontainers.image.version="0.2.0-unified.15.6" \
      org.opencontainers.image.source="https://github.com/humanitylabs-org/wizard-messenger"
COPY server.py web.py unified.py connector_setup.py connectors.py connector_inbox.py connector_web.py connector_sender.py agent_tools.py wizard_agents.py agent_keys.py permissions.py drafts.py /app/
COPY plumbing /app/plumbing
COPY static /app/static/
