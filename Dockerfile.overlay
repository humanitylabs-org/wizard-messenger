# Python/static-only packaging over the exact live binary carrier. No owner data.
FROM wizard-messenger:0.2.0-unified.12.10
ARG REVISION
LABEL org.opencontainers.image.revision=$REVISION \
      org.opencontainers.image.version="0.2.0-unified.12.11" \
      org.opencontainers.image.source="https://github.com/humanitylabs-org/wizard-messenger"
COPY --chmod=a+rX server.py web.py unified.py connector_setup.py connectors.py connector_inbox.py connector_web.py connector_sender.py /app/
COPY --chmod=a+rX plumbing /app/plumbing
COPY --chmod=a+rX static /app/static/
