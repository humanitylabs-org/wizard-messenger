+++ b/pkg/connector/wizardcontacts_test.go
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+package connector
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"go.mau.fi/mautrix-telegram/pkg/gotd/tg"
+)
+
+type contactRecordingAPI struct {
+	user  tg.User
+	adds  []*tg.ContactsAddContactRequest
+	reads int
+}
+
+func (a *contactRecordingAPI) UsersGetUsers(ctx context.Context, id []tg.InputUserClass) ([]tg.UserClass, error) {
+	a.reads++
+	u := a.user
+	return []tg.UserClass{&u}, nil
+}
+
+func (a *contactRecordingAPI) ContactsAddContact(ctx context.Context, req *tg.ContactsAddContactRequest) (tg.UpdatesClass, error) {
+	a.adds = append(a.adds, req)
+	a.user.Contact = true
+	a.user.FirstName, a.user.LastName = req.FirstName, req.LastName
+	u := a.user
+	return &tg.Updates{Users: []tg.UserClass{&u}}, nil
+}
+
+func TestWizardContactStateSaysWhoCanBeAdded(t *testing.T) {
+	for _, c := range []struct {
+		user   tg.User
+		can    bool
+		reason string
+	}{
+		{tg.User{ID: 5, FirstName: "Gil"}, true, ""},
+		{tg.User{ID: 5, Contact: true}, false, "contact"},
+		{tg.User{ID: 5, Bot: true}, false, "bot"},
+		{tg.User{ID: 5, Self: true}, false, "self"},
+		{tg.User{ID: 5, Deleted: true}, false, "deleted"},
+	} {
+		got := wizardContactState(&c.user)
+		if got.CanAdd != c.can || got.Reason != c.reason || got.UserID != "5" {
+			t.Fatalf("%+v -> %+v", c.user, got)
+		}
+	}
+}
+
+func TestWizardAddContactAddsWithTheNameAndNoPhone(t *testing.T) {
+	api := &contactRecordingAPI{user: tg.User{ID: 555, AccessHash: 9, FirstName: "gil", LastName: "n"}}
+	input := &tg.InputUser{UserID: 555, AccessHash: 9}
+	user, _, err := wizardAddContact(context.Background(), api, input, "  Gil ", " Novak ")
+	if err != nil || user == nil || !user.Contact {
+		t.Fatalf("user=%+v err=%v", user, err)
+	}
+	if len(api.adds) != 1 {
+		t.Fatalf("adds %d", len(api.adds))
+	}
+	req := api.adds[0]
+	if req.FirstName != "Gil" || req.LastName != "Novak" || req.Phone != "" || req.AddPhonePrivacyException {
+		t.Fatalf("request %+v: name trimmed, owner's phone never shared", req)
+	}
+	if in, ok := req.ID.(*tg.InputUser); !ok || in.UserID != 555 || in.AccessHash != 9 {
+		t.Fatalf("id %+v", req.ID)
+	}
+	// Already a contact now: a repeat changes nothing on Telegram.
+	if _, _, err := wizardAddContact(context.Background(), api, input, "Other", ""); err != nil || len(api.adds) != 1 {
+		t.Fatalf("repeat must not add again: %d %v", len(api.adds), err)
+	}
+}
+
+func TestWizardAddContactFallsBackToTheirOwnNameAndRefusesBots(t *testing.T) {
+	api := &contactRecordingAPI{user: tg.User{ID: 7, FirstName: "", LastName: "Solo"}}
+	if _, _, err := wizardAddContact(context.Background(), api, &tg.InputUser{UserID: 7}, " ", ""); err != nil {
+		t.Fatal(err)
+	}
+	if api.adds[0].FirstName != "Solo" || api.adds[0].LastName != "" {
+		t.Fatalf("fallback %+v", api.adds[0])
+	}
+	long := strings.Repeat("é", 80)
+	api = &contactRecordingAPI{user: tg.User{ID: 8, FirstName: "x"}}
+	if _, _, err := wizardAddContact(context.Background(), api, &tg.InputUser{UserID: 8}, long, ""); err != nil || len([]rune(api.adds[0].FirstName)) != 64 {
+		t.Fatalf("name cut to 64 characters: %v", err)
+	}
+	bot := &contactRecordingAPI{user: tg.User{ID: 9, Bot: true, FirstName: "Bot"}}
+	if _, _, err := wizardAddContact(context.Background(), bot, &tg.InputUser{UserID: 9}, "Bot", ""); err == nil || len(bot.adds) != 0 {
+		t.Fatal("a bot is never added")
+	}
+}
