diff --git a/pkg/connector/own_read.go b/pkg/connector/own_read.go
new file mode 100644
index 0000000..aa3e63e
--- /dev/null
+++ b/pkg/connector/own_read.go
@@ -0,0 +1,53 @@
+package connector
+
+import (
+	"time"
+
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/bridgev2/networkid"
+	"maunium.net/go/mautrix/bridgev2/simplevent"
+
+	"github.com/beeper/line/pkg/line"
+)
+
+// makeOwnReadReceiptEvent turns LINE's SEND_CHAT_CHECKED operation (type 40: the
+// logged-in user read a chat on one of their clients) into a Matrix read receipt
+// from the owner. param1 is the chat MID (the portal ID) and param2 the ID of the
+// last message that was read. NOTIFIED_READ_MESSAGE (type 55) only covers other
+// people reading, so without this the owner's reads in the LINE app never reach
+// Matrix and their unread counts stay stuck.
+//
+// The receipt targets the message ID, never a timestamp, so messages that arrived
+// after the one that was read stay unread.
+func (lc *LineClient) makeOwnReadReceiptEvent(op line.Operation) (*simplevent.Receipt, bool) {
+	if op.Param1 == "" || op.Param2 == "" {
+		return nil, false
+	}
+	ownMID := lc.Mid
+	if ownMID == "" && lc.UserLogin != nil && lc.UserLogin.UserLogin != nil {
+		ownMID = string(lc.UserLogin.ID)
+	}
+	if ownMID == "" {
+		return nil, false
+	}
+	var ts time.Time
+	if ms, err := op.CreatedTime.Int64(); err == nil && ms > 0 {
+		ts = time.UnixMilli(ms)
+	}
+	var receiver networkid.UserLoginID
+	if lc.UserLogin != nil && lc.UserLogin.UserLogin != nil {
+		receiver = lc.UserLogin.ID
+	}
+	return &simplevent.Receipt{
+		EventMeta: simplevent.EventMeta{
+			Type: bridgev2.RemoteEventReadReceipt,
+			PortalKey: networkid.PortalKey{
+				ID:       makePortalID(op.Param1),
+				Receiver: receiver,
+			},
+			Timestamp: ts,
+			Sender:    bridgev2.EventSender{Sender: makeUserID(ownMID), IsFromMe: true},
+		},
+		LastTarget: networkid.MessageID(op.Param2),
+	}, true
+}
diff --git a/pkg/connector/own_read_test.go b/pkg/connector/own_read_test.go
new file mode 100644
index 0000000..73560f1
--- /dev/null
+++ b/pkg/connector/own_read_test.go
@@ -0,0 +1,57 @@
+package connector
+
+import (
+	"testing"
+
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/bridgev2/networkid"
+
+	"github.com/beeper/line/pkg/line"
+)
+
+func TestSendChatCheckedBecomesOwnReadReceipt(t *testing.T) {
+	if OpSendChatChecked != 40 || OpReadReceipt != 55 {
+		t.Fatalf("operation numbers changed: %d %d", OpSendChatChecked, OpReadReceipt)
+	}
+	lc := &LineClient{Mid: "U-me"}
+	evt, ok := lc.makeOwnReadReceiptEvent(line.Operation{
+		Type: 40, Param1: "C-group", Param2: "msg-42", CreatedTime: "1784890442000",
+	})
+	if !ok {
+		t.Fatal("expected a receipt")
+	}
+	if evt.EventMeta.Type != bridgev2.RemoteEventReadReceipt {
+		t.Fatalf("type = %v", evt.EventMeta.Type)
+	}
+	if evt.EventMeta.PortalKey.ID != networkid.PortalID("C-group") {
+		t.Fatalf("portal = %v", evt.EventMeta.PortalKey)
+	}
+	if !evt.EventMeta.Sender.IsFromMe || evt.EventMeta.Sender.Sender != "U-me" {
+		t.Fatalf("sender = %#v, want the owner", evt.EventMeta.Sender)
+	}
+	if evt.GetLastReceiptTarget() != "msg-42" {
+		t.Fatalf("target = %q", evt.GetLastReceiptTarget())
+	}
+	if !evt.GetReadUpTo().IsZero() {
+		t.Fatal("a timestamp fallback would mark later messages read")
+	}
+	if evt.EventMeta.Timestamp.UnixMilli() != 1784890442000 {
+		t.Fatalf("timestamp = %v", evt.EventMeta.Timestamp)
+	}
+}
+
+func TestSendChatCheckedIgnoresIncompleteOperations(t *testing.T) {
+	lc := &LineClient{Mid: "U-me"}
+	for _, op := range []line.Operation{
+		{Type: 40, Param1: "C-group"},
+		{Type: 40, Param2: "msg-1"},
+		{Type: 40},
+	} {
+		if _, ok := lc.makeOwnReadReceiptEvent(op); ok {
+			t.Fatalf("incomplete operation %#v produced a receipt", op)
+		}
+	}
+	if _, ok := (&LineClient{}).makeOwnReadReceiptEvent(line.Operation{Type: 40, Param1: "C", Param2: "m"}); ok {
+		t.Fatal("no known owner must not produce a receipt")
+	}
+}
diff --git a/pkg/connector/photo_album.go b/pkg/connector/photo_album.go
new file mode 100644
index 0000000..ef8fbf9
--- /dev/null
+++ b/pkg/connector/photo_album.go
@@ -0,0 +1,55 @@
+package connector
+
+import (
+	"strconv"
+	"strings"
+
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/event"
+)
+
+// lineAlbumKey is the Matrix content field that tells a client which LINE photo
+// group (one multi-photo send) an image belongs to. Wizard Messenger reads it and
+// shows the group as one album, the same way it reads org.wizard.signal.album.
+const lineAlbumKey = "org.wizard.line.album"
+
+// lineAlbum reads LINE's own grouping of a multi-photo send from the message
+// metadata: GID is the group, GSEQ the photo's 1-based place and GTOTAL the number
+// of photos. LINE's official clients set these; a single photo has none (or a
+// GTOTAL of 1). Nothing is guessed from timestamps.
+func lineAlbum(meta map[string]string) (map[string]any, bool) {
+	gid := strings.TrimSpace(meta["GID"])
+	if gid == "" || gid == "0" || len(gid) > 200 {
+		return nil, false
+	}
+	total, err := strconv.Atoi(strings.TrimSpace(meta["GTOTAL"]))
+	if err != nil || total < 2 || total > 100 {
+		return nil, false
+	}
+	seq, err := strconv.Atoi(strings.TrimSpace(meta["GSEQ"]))
+	if err != nil || seq < 1 || seq > total {
+		return nil, false
+	}
+	return map[string]any{"id": gid, "index": seq - 1, "count": total}, true
+}
+
+// markLineAlbum adds the photo-group marker to the image parts of a converted
+// LINE image message. Notices (oversized, failed download) stay unmarked.
+func markLineAlbum(meta map[string]string, converted *bridgev2.ConvertedMessage) {
+	if converted == nil {
+		return
+	}
+	album, ok := lineAlbum(meta)
+	if !ok {
+		return
+	}
+	for _, part := range converted.Parts {
+		if part == nil || part.Content == nil || part.Content.MsgType != event.MsgImage {
+			continue
+		}
+		if part.Extra == nil {
+			part.Extra = map[string]any{}
+		}
+		part.Extra[lineAlbumKey] = album
+	}
+}
diff --git a/pkg/connector/photo_album_test.go b/pkg/connector/photo_album_test.go
new file mode 100644
index 0000000..cb321eb
--- /dev/null
+++ b/pkg/connector/photo_album_test.go
@@ -0,0 +1,60 @@
+package connector
+
+import (
+	"reflect"
+	"testing"
+
+	"maunium.net/go/mautrix/bridgev2"
+	"maunium.net/go/mautrix/event"
+)
+
+func TestLineAlbumReadsLineGrouping(t *testing.T) {
+	got, ok := lineAlbum(map[string]string{"GID": "612345", "GSEQ": "2", "GTOTAL": "3"})
+	want := map[string]any{"id": "612345", "index": 1, "count": 3}
+	if !ok || !reflect.DeepEqual(got, want) {
+		t.Fatalf("lineAlbum = %#v, %v; want %#v", got, ok, want)
+	}
+}
+
+func TestLineAlbumIgnoresSinglesAndBadMetadata(t *testing.T) {
+	for _, meta := range []map[string]string{
+		nil,
+		{},
+		{"GID": "1", "GSEQ": "1", "GTOTAL": "1"},
+		{"GID": "0", "GSEQ": "1", "GTOTAL": "2"},
+		{"GID": "", "GSEQ": "1", "GTOTAL": "2"},
+		{"GID": "1", "GSEQ": "0", "GTOTAL": "2"},
+		{"GID": "1", "GSEQ": "3", "GTOTAL": "2"},
+		{"GID": "1", "GSEQ": "x", "GTOTAL": "2"},
+		{"GID": "1", "GSEQ": "1", "GTOTAL": "101"},
+		{"GID": "1", "GSEQ": "1"},
+	} {
+		if got, ok := lineAlbum(meta); ok {
+			t.Errorf("lineAlbum(%v) = %#v, want no album", meta, got)
+		}
+	}
+}
+
+func TestMarkLineAlbumMarksImagePartsOnly(t *testing.T) {
+	converted := &bridgev2.ConvertedMessage{Parts: []*bridgev2.ConvertedMessagePart{
+		{Type: event.EventMessage, Content: &event.MessageEventContent{MsgType: event.MsgImage}},
+		{Type: event.EventMessage, Content: &event.MessageEventContent{MsgType: event.MsgNotice}},
+		nil,
+	}}
+	markLineAlbum(map[string]string{"GID": "g", "GSEQ": "1", "GTOTAL": "2"}, converted)
+	want := map[string]any{"id": "g", "index": 0, "count": 2}
+	if got := converted.Parts[0].Extra[lineAlbumKey]; !reflect.DeepEqual(got, want) {
+		t.Fatalf("image part marker = %#v, want %#v", got, want)
+	}
+	if _, ok := converted.Parts[1].Extra[lineAlbumKey]; ok {
+		t.Fatal("a notice part must not join an album")
+	}
+	markLineAlbum(map[string]string{"GID": "g", "GSEQ": "1", "GTOTAL": "2"}, nil)
+	single := &bridgev2.ConvertedMessage{Parts: []*bridgev2.ConvertedMessagePart{
+		{Type: event.EventMessage, Content: &event.MessageEventContent{MsgType: event.MsgImage}},
+	}}
+	markLineAlbum(map[string]string{}, single)
+	if single.Parts[0].Extra != nil {
+		t.Fatalf("a single photo got Extra %#v", single.Parts[0].Extra)
+	}
+}
